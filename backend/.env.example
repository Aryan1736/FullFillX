# =================================================================
# FulfillX Backend Environment Variables Template
# =================================================================

# Database Connection (Neon PostgreSQL or local Postgres)
# In production with Neon, always include ?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_HOST>:5432/<NEON_DATABASE>?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=placeholder_password

# Port configuration (Render provides PORT dynamically)
PORT=8080

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Hibernate DDL generation strategy
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Disable Spring Boot Docker Compose in cloud/production
SPRING_DOCKER_COMPOSE_ENABLED=false

# Spring AI OpenAI configuration (optional placeholder)
OPENAI_API_KEY=placeholder
