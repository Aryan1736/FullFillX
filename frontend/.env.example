# =================================================================
# FulfillX Frontend Environment Variables Template
# =================================================================

# Local Development (uses Vite dev-server proxy configured in vite.config.ts):
# VITE_API_BASE_URL=/api/v1

# Production Deployment (Vercel pointing to Render backend URL):
# Do NOT add a trailing slash
VITE_API_BASE_URL=https://<YOUR-RENDER-SERVICE-NAME>.onrender.com/api/v1
